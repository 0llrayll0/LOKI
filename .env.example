# LOKI — variáveis de ambiente (defaults de DEV, sem credenciais reais)

# API
LOKI_API_PORT=8100
LOKI_SERVICE_NAME=loki-api
LOKI_LOG_LEVEL=INFO

# Postgres
# POSTGRES_HOST=loki-postgres resolve APENAS de dentro do docker compose
# (nome do serviço/container em docker-compose.yml).
POSTGRES_USER=loki
POSTGRES_PASSWORD=loki_dev_password
POSTGRES_DB=loki
POSTGRES_HOST=loki-postgres
POSTGRES_PORT=5432

# Para rodar a API FORA do compose (uv run uvicorn ... no host), usar localhost
# com a porta exposta do container postgres (5434 no docker-compose.yml):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5434

# Redis
REDIS_URL=redis://loki-redis:6379/0

# uid/gid do host (user line) — arquivos em ./datasets ficam do host
LOKI_UID=1000
LOKI_GID=1000

# Secret for encrypting AI provider credentials (outside DB)
LOKI_SECRET_KEY=loki-dev-secret-key-change-me-in-prod-32b!
